<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} - {{ agent_name }}</title>
  <style>
    :root {
      --bg: #f4f6f9;
      --ink: #1d2430;
      --muted: #667085;
      --line: #d8e0ea;
      --card: #ffffff;
      --soft: #eef3f8;
      --green: #1f7a4d;
      --red: #bf3b3b;
      --blue: #235fa4;
      --amber: #a46b13;
      --violet: #6953a8;
      --shadow: 0 12px 30px rgba(25, 35, 50, 0.08);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Inter, "Segoe UI", Arial, sans-serif;
      background: linear-gradient(180deg, #f7f9fc 0%, var(--bg) 100%);
      color: var(--ink);
      line-height: 1.56;
    }
    a { color: inherit; }
    .wrap { max-width: 1220px; margin: 0 auto; padding: 32px 24px 56px; }
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) auto;
      gap: 24px;
      align-items: end;
      padding: 24px;
      background: rgba(255,255,255,.8);
      border: 1px solid var(--line);
      border-radius: 8px;
      box-shadow: var(--shadow);
    }
    h1 { margin: 0; font-size: 36px; letter-spacing: 0; }
    h2 { margin: 0 0 14px; font-size: 21px; letter-spacing: 0; }
    h3 { margin: 0 0 10px; font-size: 16px; }
    .sub {
      margin-top: 10px;
      color: var(--muted);
      max-width: 70ch;
    }
    .summary {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 16px;
    }
    .badge,
    .tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-radius: 999px;
      padding: 5px 10px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }
    .badge {
      background: #fff;
      border: 1px solid var(--line);
      color: var(--ink);
    }
    .tag { color: #fff; background: var(--muted); }
    .grade-a { background: var(--green); }
    .grade-b { background: #3d7f5e; }
    .grade-c { background: var(--blue); }
    .grade-d { background: var(--amber); }
    .grade-e { background: var(--red); }
    .hero-score {
      min-width: 160px;
      padding: 18px 20px;
      border-radius: 8px;
      background: #111827;
      color: #fff;
      text-align: center;
      box-shadow: var(--shadow);
    }
    .hero-score strong { display: block; font-size: 48px; line-height: 1; }
    .hero-score span { display: block; color: #c7d0db; margin-top: 6px; font-size: 13px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 12px;
      margin-top: 16px;
    }
    .card,
    .metric-card {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 16px;
      box-shadow: var(--shadow);
    }
    .card .label,
    .metric-card .label {
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .card .value,
    .metric-card .value {
      margin-top: 6px;
      font-size: 32px;
      font-weight: 700;
    }
    .section {
      background: rgba(255,255,255,.84);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 18px;
      margin-top: 16px;
      box-shadow: var(--shadow);
    }
    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }
    .section .muted { color: var(--muted); }
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }
    .meta-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 14px;
    }
    .meta-card span {
      display: block;
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .meta-card strong {
      display: block;
      margin-top: 6px;
      font-size: 14px;
      word-break: break-word;
    }
    .table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
    }
    .table th, .table td {
      border-bottom: 1px solid var(--line);
      padding: 11px 12px;
      text-align: left;
      vertical-align: top;
    }
    .table th {
      background: #eef3f8;
      color: #475467;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .table td code {
      background: #f3f5f7;
      border-radius: 4px;
      padding: 2px 5px;
    }
    .timeline td:first-child { width: 72px; color: var(--muted); }
    .timeline td:nth-child(2) { width: 160px; }
    .timeline tr:nth-child(even) { background: #fbfcfe; }
    .list {
      margin: 0;
      padding-left: 20px;
    }
    .list li { margin: 6px 0; }
    .callout {
      padding: 14px 16px;
      border-radius: 8px;
      background: #eef4fb;
      border: 1px solid #d3e0ef;
    }
    .callout strong {
      display: block;
      margin-bottom: 8px;
    }
    .callout p {
      margin: 0;
      color: var(--ink);
    }
    .artifacts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin: 0;
    }
    .artifacts > div {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 14px;
    }
    .artifacts dt {
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .04em;
    }
    .artifacts dd {
      margin: 6px 0 0;
      word-break: break-word;
    }
    .signal-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 12px;
    }
    .review-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .subpanel {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 14px;
    }
    .conclusion {
      padding: 18px;
      background: linear-gradient(180deg, #fff, #f8fafc);
      border: 1px solid var(--line);
      border-radius: 8px;
    }
    .conclusion p { margin: 0; }
    details {
      margin-top: 12px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #fff;
      overflow: hidden;
    }
    summary {
      cursor: pointer;
      list-style: none;
      padding: 14px 16px;
      font-weight: 700;
      background: #f8fbff;
    }
    summary::-webkit-details-marker { display: none; }
    details > div {
      padding: 0 16px 16px;
    }
    .footer {
      margin-top: 20px;
      color: var(--muted);
      font-size: 13px;
      text-align: center;
    }
    .kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .08em;
    }
    @media (max-width: 980px) {
      .hero, .meta-grid, .grid, .signal-grid, .artifacts, .review-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 720px) {
      .wrap { padding: 20px 14px 40px; }
      .hero, .meta-grid, .grid, .signal-grid, .artifacts, .review-grid { grid-template-columns: 1fr; }
      .hero { padding: 18px; }
      h1 { font-size: 30px; }
      .hero-score { width: 100%; }
    }
  </style>
</head>
<body>
  <main class="wrap">
    <section class="hero">
      <div>
        <div class="kicker">AgentOps Lite Report</div>
        <h1>{{ agent_name }} / {{ model_name }}</h1>
        <div class="sub">
          {{ task_name }} | {{ task_type }}<br>
          {{ task_description }}
        </div>
        <div class="summary">
          <span class="badge">run_id: <code>{{ run_id }}</code></span>
          <span class="badge">status: {{ status_phrase }}</span>
          <span class="badge">generated: {{ generated_at }}</span>
        </div>
        <div class="summary">{{ summary_badges_html }}</div>
      </div>
      <div class="hero-score">
        <strong>{{ overall_score }}</strong>
        <span>overall score</span>
      </div>
    </section>

    <section class="grid">
      {{ score_cards_html }}
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Run Signals</h2>
        <span class="muted">Compact overview of execution shape</span>
      </div>
      <div class="signal-grid">
        {{ metric_cards_html }}
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Run Metadata</h2>
        <span class="muted">Task and artifact snapshot</span>
      </div>
      <div class="meta-grid">
        <div class="meta-card"><span>Task name</span><strong>{{ task_name }}</strong></div>
        <div class="meta-card"><span>Task type</span><strong>{{ task_type }}</strong></div>
        <div class="meta-card"><span>Started at</span><strong>{{ started_at }}</strong></div>
        <div class="meta-card"><span>Finished at</span><strong>{{ finished_at }}</strong></div>
        <div class="meta-card"><span>Log path</span><strong>{{ log_path }}</strong></div>
        <div class="meta-card"><span>Diff path</span><strong>{{ diff_path }}</strong></div>
        <div class="meta-card"><span>Score band</span><strong>{{ score_grade }} / {{ score_label }}</strong></div>
        <div class="meta-card"><span>Generated at</span><strong>{{ generated_at }}</strong></div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Executive Summary</h2>
        <span class="muted">A compact read on the run</span>
      </div>
      <div class="callout">
        <strong>{{ status_phrase }}</strong>
        <p>{{ next_action_md }}</p>
      </div>
      <details open>
        <summary>What stands out</summary>
        <div>{{ risk_flags_html }}</div>
      </details>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Metrics</h2>
        <span class="muted">Signals extracted from logs and diff</span>
      </div>
      {{ metrics_table_html }}
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Artifacts</h2>
        <span class="muted">Useful when you need to revisit evidence</span>
      </div>
      {{ artifact_html }}
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Agent Timeline</h2>
        <span class="muted">Ordered execution trace</span>
      </div>
      {{ timeline_html }}
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Errors, Retries, and Test Signals</h2>
        <span class="muted">The part that usually matters most</span>
      </div>
      {{ errors_html }}
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Review</h2>
        <span class="muted">What worked and what needs attention</span>
      </div>
      <div class="review-grid">
        <div class="subpanel"><h3>Strengths</h3>{{ strengths_html }}</div>
        <div class="subpanel"><h3>Weaknesses</h3>{{ weaknesses_html }}</div>
        <div class="subpanel"><h3>Failure Reasons</h3>{{ failure_reasons_html }}</div>
        <div class="subpanel"><h3>Improvement Suggestions</h3>{{ improvement_suggestions_html }}</div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Conclusion</h2>
        <span class="muted">Final readout</span>
      </div>
      <div class="conclusion">{{ conclusion_html }}</div>
    </section>

    <div class="footer">
      Generated by AgentOps Lite | local-first AI coding agent workflow analysis
    </div>
  </main>
</body>
</html>
